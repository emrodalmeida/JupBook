   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "f = 1.0\n",
    "x = np.linspace(0.0, 2 * np.pi, 1000)\n",
    "y = np.sin(f * x)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "ax.plot(x, y)\n",
    "plt.show()"
   ]
  }
